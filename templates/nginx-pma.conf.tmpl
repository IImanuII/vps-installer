# vps-installer: phpMyAdmin solo sul dominio del pannello
location = /pma {
    return 301 /pma/;
}

location ^~ /pma/ {
    alias ${VPS_OPT}/phpmyadmin/;
    index index.php;
    auth_basic "Area riservata";
    auth_basic_user_file /etc/nginx/.htpasswd-pma;
    # Al primo accesso phpMyAdmin chiede decine di immagini, script e chiamate in pochi istanti:
    # con il burst=20 del pannello una parte tornava 429 e la pagina restava bianca. Dietro
    # l'autenticazione HTTP, un burst largo come per i file statici di WordPress (vale anche
    # per le location qui dentro, che non hanno un limit_req proprio).
    limit_req zone=req_limit_per_ip burst=200 nodelay;

    location ~ ^/pma/(libraries|templates|vendor|sql|src|setup)/ {
        deny all;
    }
    location ~ ^/pma/config\.inc\.php$ {
        deny all;
    }
    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $request_filename;
        fastcgi_pass unix:/run/php/php${PHP_VERSION}-fpm-panel.sock;
    }
}
