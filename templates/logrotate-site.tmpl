# vps-site: file generato, non modificarlo a mano
# Log di Nginx: logs/ è di root, ruota root senza "su".
${SITE_ROOT}/logs/*.log {
    weekly
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}
# Log di PHP: logs/php/ è del sito; logrotate ci lavora come utente del sito,
# così un link messo lì dal sito non gli fa toccare file di root.
${SITE_ROOT}/logs/php/*.log {
    su ${SITE_SLUG} ${SITE_SLUG}
    weekly
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}
