[Unit]
Description=Cloudflare Tunnel per l'accesso SSH dal browser (vps-ssh-tunnel)
After=network-online.target
Wants=network-online.target

[Service]
# Il token del tunnel sta solo in questo file (600 root) e arriva a cloudflared
# come TUNNEL_TOKEN nell'ambiente: tra gli argomenti sarebbe visibile in ps.
EnvironmentFile=/opt/vps/secrets/cf-tunnel.env
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run
# cloudflared non ha bisogno di root: un utente usa e getta, senza privilegi.
DynamicUser=yes
NoNewPrivileges=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
