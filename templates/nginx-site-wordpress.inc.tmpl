    location = /favicon.ico {
        log_not_found off;
        access_log off;
    }

    location = /robots.txt {
        allow all;
        log_not_found off;
        access_log off;
    }

    # xmlrpc.php: bersaglio classico di attacchi a forza bruta, WordPress non ne ha bisogno.
    location = /xmlrpc.php {
        deny all;
    }

    # Niente PHP tra i file caricati: un upload malevolo non deve poter essere eseguito.
    location ~* /(?:uploads|files)/.*\.php$ {
        deny all;
    }

    # File statici: molti insieme a ogni pagina (temi, editor a blocchi), quindi un
    # burst largo; cache del browser e niente log di accesso.
    location ~* \.(?:css|js|mjs|map|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|otf|eot)$ {
        limit_req zone=req_limit_per_ip burst=200 nodelay;
        expires 30d;
        access_log off;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php${PHP_VERSION}-fpm-${SITE_SLUG}.sock;
    }
