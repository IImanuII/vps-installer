#!/usr/bin/env bash
# vps-site — i siti della VPS: zones, list, show, create, disable, enable,
# delete, db-create, db-password. Contratto in docs/PANEL-HANDOFF.md, sezione 4.
# Lo esegue il pannello con sudo; _run e _prune li lanciano solo systemd e cron,
# quindi attraverso sudo (o il rilancio qui sotto) si rifiutano prima ancora di
# caricare le librerie. Questo controllo deve restare il primo.
if [[ ("${1:-}" == _run || "${1:-}" == _prune) && (-n "${SUDO_USER:-}" || -n "${VPS_SITE_VIA_SYSTEMD:-}") ]]; then
  printf '{"ok":false,"error":"comando interno"}\n'
  exit 1
fi
# PHP-FPM gira con ProtectSystem=full: sudo lanciato dal pannello eredita il suo
# spazio dei mount, dove /etc (e quindi /etc/nginx/conf.d, i pool, logrotate) è
# in sola lettura. Ci si rilancia allora in un'unità systemd nuova, fuori da
# quella sandbox: stdin (la password), stdout e codice d'uscita passano intatti.
# Il percorso è assoluto e fisso, mai preso dall'ambiente.
if [[ -n "${SUDO_USER:-}" && -z "${VPS_SITE_VIA_SYSTEMD:-}" ]]; then
  exec systemd-run --wait --pipe --collect --quiet --service-type=exec \
    --setenv=VPS_SITE_VIA_SYSTEMD=1 /opt/vps/bin/vps-site "$@"
fi
# Chiamata del pannello (sotto sudo o già rilanciata): l'ambiente del chiamante
# non deve influenzare lo script. Nell'unità systemd l'ambiente è già pulito,
# ma i valori fissi valgono comunque.
if [[ -n "${SUDO_USER:-}" || -n "${VPS_SITE_VIA_SYSTEMD:-}" ]]; then
  VPS_OPT=/opt/vps
  VPS_LIB=$VPS_OPT/lib
  VPS_TEMPLATES=$VPS_OPT/templates
  VPS_LOG=/var/log/vps-tools.log
  # La vera difesa è `Defaults:panel env_reset` in sudoers; questo elenco è una
  # seconda linea di difesa, nel caso l'ambiente passasse comunque.
  unset CF_API SITES_DIR SITES_WWW SITES_BACKUPS SITES_LOCK SITES_LOCK_WAIT SITES_RUN NGINX_CONF_D \
    PHP_POOL_D LOGROTATE_D VPS_SITE_SELF VPS_NO_CHOWN SITE_ERROR_FILE
  [[ -e "$VPS_LOG" ]] || install -m 640 /dev/null "$VPS_LOG"
  chmod 640 "$VPS_LOG"
fi
: "${VPS_OPT:=/opt/vps}" "${VPS_LOG:=/var/log/vps-tools.log}"
: "${VPS_TEMPLATES:=$VPS_OPT/templates}"
export LC_ALL=C
for _lib in "${VPS_LIB:-$VPS_OPT/lib}"/*.sh; do
  # shellcheck source=/dev/null
  source "$_lib"
done

case "${1:-}" in
  _run | _prune)
    set -uo pipefail
    if [[ "$1" == _run ]]; then
      site_run "${2:-}" "${3:-}"
    else
      site_prune
    fi
    exit $?
    ;;
esac

tool_init

usage() {
  json_err "uso: vps-site zones | list | show D | create D --type static|php [--www] [--db] | disable D | enable D | delete D | db-create D | db-password D (password da stdin per --db, db-create, db-password)"
}

need_cf() {
  [[ "$(jq -r '.cloudflare.enabled // false' "$(manifest_path)")" == true ]] \
    || json_err "Cloudflare non è attivo su questa VPS: i siti lo richiedono"
  site_cf_token || json_err "token Cloudflare mancante"
}

# existing DOMINIO — il sito deve esistere; un lavoro interrotto viene sistemato.
existing() {
  if ! valid_domain "${1:-}" || ! site_reg_exists "$1"; then
    json_err "sito non trovato: ${1:-}"
  fi
  site_refresh "$1"
}

# reg_lock — lucchetto breve sul registro, distinto da quello dei lavori: serializza
# create/delete/disable/... senza essere rifiutato quando un lavoro gira su un altro
# sito. Resta preso (fd 7) fino alla fine di questo processo, che dura poco;
# i figli di systemd-run non lo ereditano.
reg_lock() {
  exec 7>"$SITES_LOCK.reg"
  flock -w 5 7 || json_err "operazione in corso, riprova tra poco"
}

# lock_now — le operazioni brevi non aspettano: se c'è un lavoro, si riprova.
lock_now() {
  reg_lock
  exec 9>"$SITES_LOCK"
  flock -n 9 || json_err "operazione in corso su un altro sito, riprova tra poco"
}

# read_password — DB_PASSWORD dalla prima riga di stdin (mai dagli argomenti).
read_password() {
  DB_PASSWORD="$(read_stdin_limited 256 | head -n 1)"
  DB_PASSWORD="${DB_PASSWORD%$'\r'}"
  site_valid_db_password "$DB_PASSWORD" \
    || json_err "password del database non valida: 16-128 caratteri stampabili, senza spazi né apici o barre inverse"
}

# launch OP DOMINIO — il lavoro lungo parte come unità systemd, fuori da sudo e da PHP-FPM.
launch() {
  local slug
  slug="$(site_reg_get "$2" .slug)"
  if ! systemd-run --unit "vps-site-$slug-$1" --collect --quiet "$VPS_SITE_SELF" _run "$1" "$2" >>"$VPS_LOG" 2>&1; then
    site_abort "$2" "$1" "impossibile avviare il lavoro in background (dettagli in $VPS_LOG)"
    json_err "impossibile avviare il lavoro in background"
  fi
}

cmd="${1:-}"
shift || true
case "$cmd" in
  zones)
    need_cf
    out="$(cf_list_zones)" || json_err "Cloudflare non risponde o il token non è valido"
    zones=()
    [[ -z "$out" ]] || mapfile -t zones <<<"$out"
    json_ok '{ok: true, zones: $ARGS.positional}' --args "${zones[@]}"
    ;;
  list)
    json_ok --argjson s "$(site_list_json)" '{ok: true, sites: $s}'
    ;;
  show)
    existing "${1:-}"
    json_ok --argjson s "$(site_reg_get "$1" .)" '{ok: true, site: $s}'
    ;;
  create)
    d="${1:-}"
    shift || true
    type="" www=no db=no
    while (($#)); do
      case "$1" in
        --type)
          [[ -z "$type" && $# -ge 2 ]] || usage
          type="$2"
          shift 2
          ;;
        --www)
          [[ "$www" == no ]] || usage
          www=yes
          shift
          ;;
        --db)
          [[ "$db" == no ]] || usage
          db=yes
          shift
          ;;
        *) usage ;;
      esac
    done
    [[ "$type" == static || "$type" == php ]] || json_err "tipo non valido: usa --type static o --type php"
    [[ "$db" == no || "$type" == php ]] || json_err "il database si crea solo per i siti PHP"
    reg_lock
    msg="$(site_validate_new "$d")" || json_err "$msg"
    # www.<dominio> non può essere il dominio del pannello: il vhost del sito
    # gli ruberebbe il nome.
    if [[ "$www" == yes && "www.$d" == "$(jq -r '.panel.domain // empty' "$(manifest_path)")" ]]; then
      json_err "www.$d è il dominio del pannello: crea il sito senza --www"
    fi
    need_cf
    [[ "$db" == no ]] || read_password
    site_reg_new "$d" "$type" "$www" "$db"
    if [[ "$db" == yes ]]; then
      install -d -m 700 "$SITES_RUN"
      (
        umask 077
        printf '%s' "$DB_PASSWORD" >"$SITES_RUN/$(site_slug "$d").pass"
      )
    fi
    launch create "$d"
    json_ok '{ok: true, state: "creating"}'
    ;;
  disable | enable)
    d="${1:-}"
    existing "$d"
    lock_now
    state="$(site_reg_get "$d" .state)"
    if [[ "$cmd" == disable ]]; then
      [[ "$state" == active ]] || json_err "il sito non è attivo"
      mode=maintenance new=disabled
    else
      [[ "$state" == disabled ]] || json_err "il sito non è disattivato"
      mode=normal new=active
    fi
    SITE_ERROR_FILE="$(mktemp)"
    if ! site_vhost_add "$d" "$mode"; then
      msg="$(site_error_text nginx)"
      rm -f "$SITE_ERROR_FILE"
      json_err "$msg"
    fi
    rm -f "$SITE_ERROR_FILE"
    site_reg_update "$d" '.state = $s' --arg s "$new"
    json_ok --arg s "$new" '{ok: true, state: $s}'
    ;;
  delete)
    d="${1:-}"
    reg_lock
    existing "$d"
    state="$(site_reg_get "$d" .state)"
    [[ "$state" != creating && "$state" != deleting ]] || json_err "operazione in corso su $d, riprova più tardi"
    site_reg_update "$d" '.prev_state = .state | .state = "deleting"'
    site_job "$d" delete queued
    launch delete "$d"
    json_ok '{ok: true, state: "deleting"}'
    ;;
  db-create | db-password)
    d="${1:-}"
    existing "$d"
    lock_now
    state="$(site_reg_get "$d" .state)"
    [[ "$state" == active || "$state" == disabled ]] || json_err "il sito non è pronto"
    [[ "$(site_reg_get "$d" .type)" == php ]] || json_err "il database si crea solo per i siti PHP"
    if [[ "$cmd" == db-create ]]; then
      [[ "$(site_reg_get "$d" .db)" == false ]] || json_err "il sito ha già un database"
    else
      [[ "$(site_reg_get "$d" .db)" == true ]] || json_err "il sito non ha un database"
    fi
    read_password
    SITE_ERROR_FILE="$(mktemp)"
    if [[ "$cmd" == db-create ]]; then
      site_db_add "$d" "$DB_PASSWORD" || { msg="$(site_error_text db)"; rm -f "$SITE_ERROR_FILE"; json_err "$msg"; }
      site_reg_update "$d" '.db = true'
    else
      site_db_password "$d" "$DB_PASSWORD" || { msg="$(site_error_text db)"; rm -f "$SITE_ERROR_FILE"; json_err "$msg"; }
    fi
    rm -f "$SITE_ERROR_FILE"
    json_ok
    ;;
  *)
    usage
    ;;
esac
