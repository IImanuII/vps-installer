#!/usr/bin/env bash
# vps-site — i siti della VPS: zones, list, show, create, disable, enable,
# delete, db-create, db-password. Contratto in docs/PANEL-HANDOFF.md, sezione 4.
# Lo esegue il pannello con sudo; _run e _prune li lanciano solo systemd e cron,
# quindi attraverso sudo (o il rilancio qui sotto) si rifiutano prima ancora di
# caricare le librerie. Questo controllo deve restare il primo.
if [[ ("${1:-}" == _run || "${1:-}" == _prune) && (-n "${SUDO_USER:-}" || -n "${VPS_SITE_VIA_SYSTEMD:-}") ]]; then
  printf '{"ok":false,"error":"comando interno"}\n'
  exit 1
fi
# PHP-FPM gira con ProtectSystem=full: sudo lanciato dal pannello eredita il suo
# spazio dei mount, dove /etc (e quindi /etc/nginx/conf.d, i pool, logrotate) è
# in sola lettura. Ci si rilancia allora in un'unità systemd nuova, fuori da
# quella sandbox: stdin (la password), stdout e codice d'uscita passano intatti.
# Il percorso è assoluto e fisso, mai preso dall'ambiente.
if [[ -n "${SUDO_USER:-}" && -z "${VPS_SITE_VIA_SYSTEMD:-}" ]]; then
  exec systemd-run --wait --pipe --collect --quiet --service-type=exec \
    --setenv=VPS_SITE_VIA_SYSTEMD=1 /opt/vps/bin/vps-site "$@"
fi
# Chiamata del pannello (sotto sudo o già rilanciata): l'ambiente del chiamante
# non deve influenzare lo script. Nell'unità systemd l'ambiente è già pulito,
# ma i valori fissi valgono comunque.
if [[ -n "${SUDO_USER:-}" || -n "${VPS_SITE_VIA_SYSTEMD:-}" ]]; then
  VPS_OPT=/opt/vps
  VPS_LIB=$VPS_OPT/lib
  VPS_TEMPLATES=$VPS_OPT/templates
  VPS_LOG=/var/log/vps-tools.log
  # La vera difesa è `Defaults:panel env_reset` in sudoers; questo elenco è una
  # seconda linea di difesa, nel caso l'ambiente passasse comunque.
  unset CF_API SITES_DIR SITES_WWW SITES_BACKUPS SITES_LOCK SITES_LOCK_WAIT SITES_RUN NGINX_CONF_D \
    PHP_POOL_D LOGROTATE_D VPS_SITE_SELF VPS_NO_CHOWN SITE_ERROR_FILE \
    WP_BIN REDIS_ACL_FILE REDIS_ADMIN_SECRET CRON_D BK_LOCK_DIR BK_BACKUPS BK_DIR BK_STATE BK_RCLONE \
    BK_RCLONE_CONF VPS_BACKUP_SELF FM_RUNUSER
  [[ -e "$VPS_LOG" ]] || install -m 640 /dev/null "$VPS_LOG"
  chmod 640 "$VPS_LOG"
fi
: "${VPS_OPT:=/opt/vps}" "${VPS_LOG:=/var/log/vps-tools.log}"
: "${VPS_TEMPLATES:=$VPS_OPT/templates}"
export LC_ALL=C
for _lib in "${VPS_LIB:-$VPS_OPT/lib}"/*.sh; do
  # shellcheck source=/dev/null
  source "$_lib"
done

case "${1:-}" in
  _run | _prune)
    set -uo pipefail
    if [[ "$1" == _run ]]; then
      site_run "${2:-}" "${3:-}"
    else
      site_prune
    fi
    exit $?
    ;;
esac

tool_init

usage() {
  json_err "uso: vps-site zones | list | show D | create D --type static|php [--www] [--db] | create D --type wordpress [--www] --title T --admin-user U --admin-email E --login-path P [--cloudflare] | create D --from-backup NOME (sites/FILE, restore/FILE o remote:dominio/file; password del database da stdin se la copia ha un database) | wp-install D --title T --admin-user U --admin-email E --login-path P [--cloudflare] | disable D | enable D | delete D | db-create D | db-password D (password da stdin per --db, db-create, db-password, wp-install; due righe per create wordpress: database e admin WordPress)"
}

need_cf() {
  [[ "$(jq -r '.cloudflare.enabled // false' "$(manifest_path)")" == true ]] \
    || json_err "Cloudflare non è attivo su questa VPS: i siti lo richiedono"
  site_cf_token || json_err "token Cloudflare mancante"
}

# existing DOMINIO — il sito deve esistere; un lavoro interrotto viene sistemato.
existing() {
  if ! valid_domain "${1:-}" || ! site_reg_exists "$1"; then
    json_err "sito non trovato: ${1:-}"
  fi
  site_refresh "$1"
}

# no_restore DOMINIO — un ripristino (o la copia del sito) tiene il lock del sito:
# niente lavori né cambi di database finché non ha finito.
no_restore() {
  # lock condiviso fino alla fine del comando (un ripristino esclusivo non parte nel frattempo)
  if ! bk_site_lock_shared "$(site_reg_get "$1" .slug)"; then
    json_err "ripristino in corso (o copia del sito in corso): riprova tra poco"
  fi
}

# reg_lock — lucchetto breve sul registro, distinto da quello dei lavori: serializza
# create/delete/disable/... senza essere rifiutato quando un lavoro gira su un altro
# sito. Resta preso (fd 7) fino alla fine di questo processo, che dura poco;
# i figli di systemd-run non lo ereditano.
reg_lock() {
  exec 7>"$SITES_LOCK.reg"
  flock -w 5 7 || json_err "operazione in corso, riprova tra poco"
}

# lock_now — le operazioni brevi non aspettano: se c'è un lavoro, si riprova.
lock_now() {
  reg_lock
  exec 9>"$SITES_LOCK"
  flock -n 9 || json_err "operazione in corso su un altro sito, riprova tra poco"
}

# read_password — DB_PASSWORD dalla prima riga di stdin (mai dagli argomenti).
read_password() {
  DB_PASSWORD="$(read_stdin_limited 256 | head -n 1)"
  DB_PASSWORD="${DB_PASSWORD%$'\r'}"
  site_valid_db_password "$DB_PASSWORD" \
    || json_err "password del database non valida: 16-128 caratteri stampabili, senza spazi né apici o barre inverse"
}

# need_wp — WordPress vuole l'utente Redis per sito (ACL) e WP-CLI installato.
need_wp() {
  [[ "$(jq -r '.components.redis_acl // false' "$(manifest_path)")" == true ]] \
    || json_err "WordPress richiede Redis con gli utenti per sito: aggiorna gli script con install.sh --tools-only"
  [[ -x "$WP_BIN" ]] || json_err "WP-CLI mancante: aggiorna gli script con install.sh --tools-only"
}

# parse_wp_opts ARG... — le opzioni WordPress, ognuna al massimo una volta.
parse_wp_opts() {
  WP_TITLE="" WP_ADMIN_USER="" WP_ADMIN_EMAIL="" WP_LOGIN_PATH="" WP_CLOUDFLARE=false
  local have_t=no have_u=no have_e=no have_p=no have_c=no
  while (($#)); do
    case "$1" in
      --title) [[ "$have_t" == no && $# -ge 2 ]] || usage; WP_TITLE="$2"; have_t=yes; shift 2 ;;
      --admin-user) [[ "$have_u" == no && $# -ge 2 ]] || usage; WP_ADMIN_USER="$2"; have_u=yes; shift 2 ;;
      --admin-email) [[ "$have_e" == no && $# -ge 2 ]] || usage; WP_ADMIN_EMAIL="$2"; have_e=yes; shift 2 ;;
      --login-path) [[ "$have_p" == no && $# -ge 2 ]] || usage; WP_LOGIN_PATH="$2"; have_p=yes; shift 2 ;;
      --cloudflare) [[ "$have_c" == no ]] || usage; WP_CLOUDFLARE=true; have_c=yes; shift ;;
      *) usage ;;
    esac
  done
  [[ "$have_t$have_u$have_e$have_p" == yesyesyesyes ]] \
    || json_err "mancano opzioni di WordPress: --title, --admin-user, --admin-email, --login-path"
  site_wp_valid_title "$WP_TITLE" || json_err "titolo non valido (1-100 caratteri, una riga)"
  site_wp_valid_user "$WP_ADMIN_USER" || json_err "utente admin non valido (a-z 0-9 _ . -, 3-60 caratteri, non admin/root)"
  site_wp_valid_email "$WP_ADMIN_EMAIL" || json_err "email non valida"
  site_wp_valid_path "$WP_LOGIN_PATH" || json_err "percorso di login non valido (a-z 0-9 -, 4-40 caratteri, non wp-admin/login/admin)"
}

# check_wp_pass — la password admin WordPress segue le regole di quella del database.
check_wp_pass() {
  site_valid_db_password "$WP_ADMIN_PASS" \
    || json_err "password admin di WordPress non valida: 16-128 caratteri stampabili, senza spazi né apici o barre inverse"
}

# read_wp_password — WP_ADMIN_PASS dalla prima riga di stdin.
read_wp_password() {
  WP_ADMIN_PASS="$(read_stdin_limited 256 | head -n 1)"
  WP_ADMIN_PASS="${WP_ADMIN_PASS%$'\r'}"
  check_wp_pass
}

# write_wp_files DOMINIO — password admin e argomenti in $SITES_RUN (700), file 600.
write_wp_files() {
  local slug
  slug="$(site_slug "$1")"
  install -d -m 700 "$SITES_RUN"
  (
    umask 077
    printf '%s' "$WP_ADMIN_PASS" >"$SITES_RUN/$slug.wppass"
    jq -n --arg t "$WP_TITLE" --arg u "$WP_ADMIN_USER" --arg e "$WP_ADMIN_EMAIL" --arg p "$WP_LOGIN_PATH" --argjson c "$WP_CLOUDFLARE" \
      '{title: $t, admin_user: $u, admin_email: $e, login_path: $p, cloudflare: $c}' >"$SITES_RUN/$slug.wpargs"
  )
}

# launch OP DOMINIO — il lavoro lungo parte come unità systemd, fuori da sudo e da PHP-FPM.
launch() {
  local slug
  slug="$(site_reg_get "$2" .slug)"
  if ! systemd-run --unit "vps-site-$slug-$1" --collect --quiet "$VPS_SITE_SELF" _run "$1" "$2" >>"$VPS_LOG" 2>&1; then
    site_abort "$2" "$1" "impossibile avviare il lavoro in background (dettagli in $VPS_LOG)"
    json_err "impossibile avviare il lavoro in background"
  fi
}

cmd="${1:-}"
shift || true
case "$cmd" in
  zones)
    need_cf
    out="$(cf_list_zones)" || json_err "Cloudflare non risponde o il token non è valido"
    zones=()
    [[ -z "$out" ]] || mapfile -t zones <<<"$out"
    json_ok '{ok: true, zones: $ARGS.positional}' --args "${zones[@]}"
    ;;
  list)
    json_ok --argjson s "$(site_list_json)" '{ok: true, sites: $s}'
    ;;
  show)
    existing "${1:-}"
    json_ok --argjson s "$(site_reg_json_full "$(site_reg_path "$1")")" '{ok: true, site: $s}'
    ;;
  create)
    d="${1:-}"
    shift || true
    type="" www=no db=no fb=""
    wp_args=()
    while (($#)); do
      case "$1" in
        --type)
          [[ -z "$type" && $# -ge 2 ]] || usage
          type="$2"
          shift 2
          ;;
        --www)
          [[ "$www" == no ]] || usage
          www=yes
          shift
          ;;
        --db)
          [[ "$db" == no ]] || usage
          db=yes
          shift
          ;;
        --from-backup)
          [[ -z "$fb" && $# -ge 2 ]] || usage
          fb="$2"
          shift 2
          ;;
        --title | --admin-user | --admin-email | --login-path)
          [[ $# -ge 2 ]] || usage
          wp_args+=("$1" "$2")
          shift 2
          ;;
        --cloudflare)
          wp_args+=("$1")
          shift
          ;;
        *) usage ;;
      esac
    done
    if [[ -n "$fb" ]]; then
      # ricreato da una copia: tipo, www e database vengono dal manifest, WordPress non
      # si installa (i file e il database arrivano dal ripristino)
      [[ -z "$type" && "$www" == no && "$db" == no && ${#wp_args[@]} -eq 0 ]] \
        || json_err "con --from-backup il tipo, www e il database vengono dalla copia: togli --type, --www, --db e le opzioni di WordPress"
      valid_domain "$d" || json_err "dominio non valido: $d"
      site_fb_load "$d" "$fb" || json_err "$FB_ERR"
      type="$FB_TYPE" www="$FB_WWW" db="$FB_DB"
    else
      [[ "$type" == static || "$type" == php || "$type" == wordpress ]] || json_err "tipo non valido: usa --type static, php o wordpress"
      # le opzioni di WordPress hanno senso solo con il suo tipo
      [[ "$type" == wordpress || ${#wp_args[@]} -eq 0 ]] || usage
      [[ "$type" != wordpress || "$db" == no ]] || json_err "WordPress ha sempre il database: togli --db"
      [[ "$db" == no || "$type" == php ]] || json_err "il database si crea solo per i siti PHP"
      if [[ "$type" == wordpress ]]; then
        db=yes
        parse_wp_opts "${wp_args[@]}"
      fi
    fi
    reg_lock
    msg="$(site_validate_new "$d")" || json_err "$msg"
    # www.<dominio> non può essere il dominio del pannello: il vhost del sito
    # gli ruberebbe il nome.
    if [[ "$www" == yes && "www.$d" == "$(jq -r '.panel.domain // empty' "$(manifest_path)")" ]]; then
      json_err "www.$d è il dominio del pannello: crea il sito senza --www"
    fi
    need_cf
    if [[ -n "$fb" ]]; then
      [[ "$type" != wordpress ]] || need_wp
      # una riga: la password del database nuovo (se la copia ha un database)
      [[ "$db" == no ]] || read_password
    elif [[ "$type" == wordpress ]]; then
      need_wp
      # due righe: password del database, poi password admin di WordPress
      { IFS= read -r DB_PASSWORD; IFS= read -r WP_ADMIN_PASS; } < <(read_stdin_limited 512) || true
      DB_PASSWORD="${DB_PASSWORD%$'\r'}" WP_ADMIN_PASS="${WP_ADMIN_PASS%$'\r'}"
      site_valid_db_password "$DB_PASSWORD" \
        || json_err "password del database non valida: 16-128 caratteri stampabili, senza spazi né apici o barre inverse"
      check_wp_pass
    elif [[ "$db" == yes ]]; then
      read_password
    fi
    site_reg_new "$d" "$type" "$www" "$db"
    if [[ -n "$fb" ]]; then
      site_reg_update "$d" '.from_backup = {source: $s, name: $n, login_path: (if $l == "" then null else $l end)}' \
        --arg s "$FB_SRC" --arg n "$FB_NAME" --arg l "$FB_LOGIN"
    elif [[ "$type" == wordpress ]]; then
      write_wp_files "$d"
    fi
    if [[ "$db" == yes ]]; then
      install -d -m 700 "$SITES_RUN"
      (
        umask 077
        printf '%s' "$DB_PASSWORD" >"$SITES_RUN/$(site_slug "$d").pass"
      )
    fi
    launch create "$d"
    json_ok '{ok: true, state: "creating"}'
    ;;
  wp-install)
    d="${1:-}"
    shift || true
    reg_lock
    existing "$d"
    no_restore "$d"
    [[ "$(site_reg_get "$d" .type)" == php ]] || json_err "WordPress si installa solo su un sito PHP"
    [[ "$(site_reg_get "$d" .state)" == active ]] || json_err "il sito non è attivo"
    [[ "$(site_reg_get "$d" .db)" == true ]] || json_err "il sito non ha un database: aggiungilo prima"
    site_placeholder_intact "$d" || json_err "public/ non è vuota: WordPress si installa solo su un sito appena creato"
    need_wp
    parse_wp_opts "$@"
    read_wp_password
    write_wp_files "$d"
    # stato e lavoro in un solo aggiornamento: site_run vuole "installing" e
    # site_refresh controlla l'unità vps-site-<slug>-wpinstall da job.op/ts
    site_reg_update "$d" '.state = "installing" | .job = {op: "wpinstall", step: "queued", error: null, updated_at: $at, ts: ($ts | tonumber)}' \
      --arg at "$(date -Iseconds)" --arg ts "$(date +%s)"
    launch wpinstall "$d"
    json_ok '{ok: true, state: "installing"}'
    ;;
  disable | enable)
    d="${1:-}"
    existing "$d"
    no_restore "$d"
    lock_now
    state="$(site_reg_get "$d" .state)"
    if [[ "$cmd" == disable ]]; then
      [[ "$state" == active ]] || json_err "il sito non è attivo"
      mode=maintenance new=disabled
    else
      [[ "$state" == disabled ]] || json_err "il sito non è disattivato"
      mode=normal new=active
    fi
    SITE_ERROR_FILE="$(mktemp)"
    if ! site_vhost_add "$d" "$mode"; then
      msg="$(site_error_text nginx)"
      rm -f "$SITE_ERROR_FILE"
      json_err "$msg"
    fi
    rm -f "$SITE_ERROR_FILE"
    site_reg_update "$d" '.state = $s' --arg s "$new"
    json_ok --arg s "$new" '{ok: true, state: $s}'
    ;;
  delete)
    d="${1:-}"
    reg_lock
    existing "$d"
    no_restore "$d"
    state="$(site_reg_get "$d" .state)"
    [[ "$state" != creating && "$state" != deleting ]] || json_err "operazione in corso su $d, riprova più tardi"
    site_reg_update "$d" '.prev_state = .state | .state = "deleting"'
    site_job "$d" delete queued
    launch delete "$d"
    json_ok '{ok: true, state: "deleting"}'
    ;;
  db-create | db-password)
    d="${1:-}"
    existing "$d"
    no_restore "$d"
    lock_now
    state="$(site_reg_get "$d" .state)"
    [[ "$state" == active || "$state" == disabled ]] || json_err "il sito non è pronto"
    if [[ "$cmd" == db-create ]]; then
      [[ "$(site_reg_get "$d" .type)" == php ]] || json_err "il database si crea solo per i siti PHP"
    else
      t="$(site_reg_get "$d" .type)"
      [[ "$t" == php || "$t" == wordpress ]] || json_err "il database si gestisce solo per i siti PHP e WordPress"
    fi
    if [[ "$cmd" == db-create ]]; then
      [[ "$(site_reg_get "$d" .db)" == false ]] || json_err "il sito ha già un database"
    else
      [[ "$(site_reg_get "$d" .db)" == true ]] || json_err "il sito non ha un database"
    fi
    read_password
    SITE_ERROR_FILE="$(mktemp)"
    if [[ "$cmd" == db-create ]]; then
      site_db_add "$d" "$DB_PASSWORD" || { msg="$(site_error_text db)"; rm -f "$SITE_ERROR_FILE"; json_err "$msg"; }
      site_reg_update "$d" '.db = true'
    else
      site_db_password "$d" "$DB_PASSWORD" || { msg="$(site_error_text db)"; rm -f "$SITE_ERROR_FILE"; json_err "$msg"; }
    fi
    rm -f "$SITE_ERROR_FILE"
    json_ok
    ;;
  *)
    usage
    ;;
esac
