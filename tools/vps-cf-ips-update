#!/usr/bin/env bash
# vps-cf-ips-update — aggiorna real_ip di Nginx e regole UFW con gli IP Cloudflare.
# Scrive in /etc (snippet di Nginx, regole UFW). Precauzione (vedi vps-site): sudo
# lanciato dal pannello eredita lo spazio dei mount di PHP-FPM, che oggi su Debian 13
# non ha ProtectSystem ma con ProtectSystem=full (unità upstream) avrebbe /etc in sola
# lettura. Ci si rilancia allora in un'unità systemd nuova: stdin, stdout e codice
# d'uscita passano intatti. Il percorso è assoluto e fisso, mai preso dall'ambiente.
if [[ -n "${SUDO_USER:-}" && -z "${VPS_CFIPS_VIA_SYSTEMD:-}" ]]; then
  exec systemd-run --wait --pipe --collect --quiet --service-type=exec \
    --setenv=VPS_CFIPS_VIA_SYSTEMD=1 /opt/vps/bin/vps-cf-ips-update "$@"
fi
# Sotto sudo (o nell'unità del rilancio) l'ambiente del chiamante non deve influenzare
# lo script.
if [[ -n "${SUDO_USER:-}" || -n "${VPS_CFIPS_VIA_SYSTEMD:-}" ]]; then
  VPS_OPT=/opt/vps
  VPS_LIB=$VPS_OPT/lib
  VPS_TEMPLATES=$VPS_OPT/templates
  VPS_LOG=/var/log/vps-tools.log
  unset MSMTPRC_LINK HTPASSWD_PMA ALIASES_FILE PMA_DIR NGINX_SNIPPETS CF_API CF_IPS_URL PMA_BASE_URL
  [[ -e "$VPS_LOG" ]] || install -m 640 /dev/null "$VPS_LOG"
  chmod 640 "$VPS_LOG"
fi
: "${VPS_OPT:=/opt/vps}" "${VPS_LOG:=/var/log/vps-tools.log}"
: "${VPS_TEMPLATES:=$VPS_OPT/templates}"
for _lib in "${VPS_LIB:-$VPS_OPT/lib}"/*.sh; do
  # shellcheck source=/dev/null
  source "$_lib"
done
tool_init

m="$(manifest_path)"
[[ "$(jq -r '.cloudflare.enabled' "$m")" == true ]] || json_err "Cloudflare non è attivo su questa VPS"
lock=no
if [[ "$(jq -r '.cloudflare.origin_locked' "$m")" == true ]]; then
  lock=yes
fi
cf_apply_ips "$lock"
now="$(date -Iseconds)"
manifest_set '.cloudflare.ips_updated_at = $t' --arg t "$now"
json_ok --arg t "$now" '{ok: true, updated_at: $t}'
