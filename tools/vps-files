#!/usr/bin/env bash
# vps-files — file dei siti come utente del sito: list, stat, read, write, mkdir, rename, move, copy, delete, zip, unzip, download-zip
# Lo esegue il pannello con sudo (chiamante non fidato): root non apre mai file del
# sito, tutto passa da `runuser` con l'utente del sito. Unica eccezione: le voci
# dirette di logs/ (cartella di root, dove il sito non scrive), lette come root solo
# se file regolari e non link. Contratto in docs/PANEL-HANDOFF.md, sezione 4.
if [[ -n "${SUDO_USER:-}" ]]; then
  VPS_OPT=/opt/vps
  VPS_LIB=$VPS_OPT/lib
  VPS_TEMPLATES=$VPS_OPT/templates
  VPS_LOG=/var/log/vps-tools.log
  unset CF_API FM_RUNUSER SITES_DIR SITES_WWW
  [[ -e "$VPS_LOG" ]] || install -m 640 /dev/null "$VPS_LOG"
  chmod 640 "$VPS_LOG"
fi
: "${VPS_OPT:=/opt/vps}" "${VPS_LOG:=/var/log/vps-tools.log}"
: "${VPS_TEMPLATES:=$VPS_OPT/templates}"
export LC_ALL=C
for _lib in "${VPS_LIB:-$VPS_OPT/lib}"/*.sh; do
  # shellcheck source=/dev/null
  source "$_lib"
done
tool_init

# Numero di argomenti per comando (comando e dominio compresi):
#   list|stat|read|mkdir DOM PERCORSO                       esattamente 3
#   write  DOM PERCORSO [--overwrite] [--if-mtime M --if-size N]   da 3 a 8, contenuto su stdin
#   rename DOM DA NUOVONOME                                 esattamente 4
#   move|copy DOM DESTINAZIONE [--overwrite] -- PERCORSO...  almeno 5
#   delete DOM -- PERCORSO...                               almeno 4
#   zip DOM DEST.zip -- PERCORSO...                         almeno 5
#   unzip DOM ARCHIVIO DESTINAZIONE [--overwrite]           4 o 5
#   download-zip DOM PERCORSO                               esattamente 3, zip su stdout
USO="uso: vps-files list|stat|read|mkdir|download-zip DOM PERCORSO | write DOM PERCORSO [--overwrite] [--if-mtime SEC.NSEC --if-size N] | rename DOM DA NUOVONOME | move|copy DOM DEST [--overwrite] -- PERCORSO... | delete DOM -- PERCORSO... | zip DOM DEST.zip -- PERCORSO... | unzip DOM ARCHIVIO DESTINAZIONE [--overwrite]"
FM_TEXT_MAX=2097152 # i limiti di scrittura (10 MB) e copia (200 MB) sono negli script sh
FM_MAX_PATHS=500
FM_LIST_MAX=10000
# Record di find, separati da NUL: tipo, dimensione, data (sec.nsec), permessi, nome.
# shellcheck disable=SC2016
FM_FIND_FMT='%y\0%s\0%T@\0%M\0%f\0'
# Dal flusso di find all'array di voci: JSON costruito solo da jq, mai a mano.
# raw false = nome con byte non UTF-8 (jq li mostra come U+FFFD): non indirizzabile.
# shellcheck disable=SC2016
FM_JQ_DEF='def mt: split(".") as $p | $p[0] + "." + ((($p[1] // "") + "000000000")[:9]);
  def entries: (split("\u0000")[:-1]) as $f
    | [range(0; ($f | length); 5) as $i
       | {name: $f[$i + 4], type: ({"f": "file", "d": "dir", "l": "link"}[$f[$i]] // "other"),
          size: ($f[$i + 1] | tonumber), mtime: ($f[$i + 2] | mt), perms: $f[$i + 3],
          raw: ($f[$i + 4] | contains("�") | not)}];'

# Funzioni per gli script sh eseguiti come utente del sito: chkp = i genitori del
# percorso sono cartelle vere (nessun collegamento simbolico lungo la strada); ex = esiste.
read -r -d '' FM_SH_LIB <<'EOS' || true
chkp() {
  local d pre oldifs r s
  d="$1"
  case "$d" in */*) d="${d%/*}" ;; *) return 0 ;; esac
  set -f
  pre=""
  oldifs="$IFS"
  IFS=/
  r=0
  for s in $d; do
    pre="${pre:+$pre/}$s"
    if [ -L "$pre" ]; then
      r=1
      break
    fi
  done
  IFS="$oldifs"
  set +f
  [ "$r" = 0 ] || return 1
  [ -d "$d" ]
}
ex() { [ -e "$1" ] || [ -L "$1" ]; }
# temporanei di operazioni interrotte (kill -9, riavvio): quelli di tmp/ oltre un'ora si tolgono
sweep() { find tmp -maxdepth 1 -name '.vpsfiles-*' -mmin +60 -exec rm -rf -- {} + 2>/dev/null; return 0; }
EOS

# Scrittura: tmp nella stessa cartella, poi rename (o ln se il file deve essere nuovo).
# Uscite: 66 non file regolare, 67 genitori non validi, 68 troppo grande, 69 cambiato, 70 esiste.
read -r -d '' FM_SH_WRITE <<'EOS' || true
t="$1"; ow="$2"; im="$3"; is="$4"
chkp "$t" || exit 67
if ex "$t"; then
  [ "$ow" = 1 ] || exit 70
  { [ -f "$t" ] && [ ! -L "$t" ]; } || exit 66
elif [ -n "$im" ]; then
  exit 69
fi
tmp="$(mktemp "${t%/*}/.vpsfiles.XXXXXX")" || exit 1
trap 'rm -f -- "$tmp"' EXIT
trap 'exit 124' INT TERM
head -c 10485761 >"$tmp"
[ "$(wc -c <"$tmp")" -le 10485760 ] || exit 68
if ex "$t"; then chmod --reference="$t" -- "$tmp"; else chmod 664 -- "$tmp"; fi
if [ -n "$im" ]; then
  cur="$(stat -c '%.9Y %s' -- "$t" 2>/dev/null)" || exit 69
  [ "$cur" = "$im $is" ] || exit 69
fi
if [ "$ow" = 1 ]; then
  mv -T -- "$tmp" "$t" || exit 1
else
  ln -- "$tmp" "$t" 2>/dev/null || exit 70
fi
stat -c '%.9Y %s' -- "$t"
EOS

read -r -d '' FM_SH_MKDIR <<'EOS' || true
chkp "$1" || exit 67
ex "$1" && exit 70
mkdir -- "$1" || exit 1
EOS

read -r -d '' FM_SH_RENAME <<'EOS' || true
chkp "$1" || exit 67
chkp "$2" || exit 67
ex "$1" || exit 65
ex "$2" && exit 70
mv -n -T -- "$1" "$2" || exit 1
EOS

# Controllo di destinazione e origini (move/copy): 65 origine mancante, 67 cartella non valida.
read -r -d '' FM_SH_CHK <<'EOS' || true
d="$1"; shift
{ [ -d "$d" ] && [ ! -L "$d" ]; } || exit 67
chkp "$d/x" || exit 67
for s; do
  chkp "$s" || exit 67
  ex "$s" || exit 65
done
EOS

# Elenco (NUL) degli argomenti che esistono già.
read -r -d '' FM_SH_EXIST <<'EOS' || true
for t; do
  if ex "$t"; then printf '%s\0' "$t"; fi
done
exit 0
EOS

read -r -d '' FM_SH_SIZE <<'EOS' || true
tot=0
for s; do
  n="$(du -sbl -- "$s" 2>/dev/null | cut -f1)"
  tot=$((tot + ${n:-0}))
done
[ "$tot" -le 209715200 ] || exit 68
EOS

# Coppie origine/destinazione: op ow s1 t1 s2 t2 ...
read -r -d '' FM_SH_MVCP <<'EOS' || true
op="$1"; ow="$2"; shift 2
c=""
sweep
# a scadenza o in errore la copia parziale non resta
trap 'if [ -n "$c" ]; then rm -rf -- "$c"; fi' EXIT
trap 'exit 124' INT TERM
while [ "$#" -gt 0 ]; do
  s="$1"; t="$2"; shift 2
  if [ "$op" = move ]; then
    if [ "$ow" = 1 ]; then rm -rf -- "$t" || exit 1; fi
    mv -n -T -- "$s" "$t" || exit 1
  elif [ "$ow" = 1 ]; then
    # copia in un nome temporaneo, poi lo si mette al posto: se la copia fallisce il vecchio resta
    c="${t%/*}/.vpsfiles-cp.$$"
    rm -rf -- "$c"
    if ! cp -P -R -T --preserve=mode,timestamps -- "$s" "$c"; then
      rm -rf -- "$c"
      exit 1
    fi
    rm -rf -- "$t" && mv -T -- "$c" "$t" || { rm -rf -- "$c"; exit 1; }
    c=""
  else
    cp -n -P -R -T --preserve=mode,timestamps -- "$s" "$t" || exit 1
  fi
done
EOS

read -r -d '' FM_SH_DEL <<'EOS' || true
for s; do chkp "$s" || exit 67; done
rm -rf -- "$@" || exit 1
EOS

# Elenco di uno zip (unzip, fase 1): ARCHIVIO. Non si fida di nulla: rifiuta tutto ciò che
# non è file o cartella, nomi assoluti/con ..//\, troppe voci, voci o totale troppo grandi
# (sulle dimensioni dichiarate; l'estrazione le ricontrolla sui byte veri). Stampa i nomi, uno
# per riga. Uscite: 65 manca, 66 non è un file regolare, 67 cartella non valida, 72 zip
# illeggibile o righe incoerenti col totale, 73 troppe voci, 74 voce > 10 MB, 75 totale > 200 MB,
# 76 collegamenti o file speciali, 77 nomi non ammessi, 78 nomi non UTF-8 o con controlli,
# 79 voci cifrate.
read -r -d '' FM_SH_ZLIST <<'EOS' || true
a="$1"
chkp "$a" || exit 67
ex "$a" || exit 65
{ [ -f "$a" ] && [ ! -L "$a" ]; } || exit 66
sweep
w=""
trap 'if [ -n "$w" ]; then rm -rf -- "$w"; fi' EXIT
trap 'exit 124' INT TERM
w="$(mktemp -d tmp/.vpsfiles-l.XXXXXX)" || exit 1
# nome fisso: zipinfo e unzip trattano [ ] * ? del nome dell'archivio come caratteri jolly
ln -- "$a" "$w/a.zip" 2>/dev/null || cp -- "$a" "$w/a.zip" || exit 1
list="$(LC_ALL=C.UTF-8 zipinfo -s "$w/a.zip" 2>/dev/null)" || exit 72
printf '%s\n' "$list" | awk '
  function fail(c) { if (!err) err = c }
  /^[-dlcbps?][^ ]+ +[0-9.]+ +[a-zA-Z0-9]+ +[0-9]+ / {
    n++
    t = substr($1, 1, 1)
    sz = $4
    nm = $0
    for (i = 0; i < 7; i++) sub(/^[^ ]+ +/, "", nm)
    sub(/^[^ ]+ /, "", nm)
    if (t != "-" && t != "d") fail(76)
    if ($5 ~ /^[TB]/) fail(79)
    if (sz + 0 > 10485760) fail(74)
    tot += sz
    if (n > 10000) fail(73)
    if (nm == "" || substr(nm, 1, 1) == "/" || index(nm, "\\") || ("/" nm "/") ~ /\/\.\.\//) fail(77)
    print nm
    next
  }
  /^[0-9]+ files?, / { total = $1 + 0; seen = 1 }
  END {
    if (!err && tot > 209715200) err = 75
    if (!err && (!seen || n == 0 || n != total)) err = 72
    exit err
  }'
exit $?
EOS

# Estrazione (unzip, fase 2): ARCHIVIO DESTINAZIONE OVERWRITE. Estrae in una cartella di
# lavoro in tmp/ con un tetto per file (ulimit -f) e uno sul totale (sorvegliante), ricontrolla
# l'albero (niente link né file speciali, voci, dimensioni), e solo dopo copia nella destinazione.
# Uscite oltre a quelle dell'elenco: 70 conflitti (nomi su stdout, separati da NUL), 71 tipo
# incompatibile (file/cartella/collegamento) con --overwrite, 124 scaduto.
read -r -d '' FM_SH_UNZIP <<'EOS' || true
a="$1"; d="$2"; ow="$3"
exec 2>/dev/null
chkp "$a" || exit 67
{ [ -f "$a" ] && [ ! -L "$a" ]; } || exit 66
{ [ -d "$d" ] && [ ! -L "$d" ]; } || exit 67
chkp "$d/x" || exit 67
pid=""
wp=""
w=""
cleanup() {
  if [ -n "$wp" ]; then kill "$wp" 2>/dev/null; fi
  if [ -n "$pid" ]; then kill -9 "$pid" 2>/dev/null; fi
  if [ -n "$w" ]; then rm -rf -- "$w"; fi
}
sweep
trap cleanup EXIT
trap 'exit 124' INT TERM
w="$(mktemp -d tmp/.vpsfiles-x.XXXXXX)" || exit 1
ln -- "$a" "$w/a.zip" 2>/dev/null || cp -- "$a" "$w/a.zip" || exit 1
w="$PWD/$w"
s="$w/s"
mkdir "$s" || exit 1
# somma dei byte dei file regolari (le cartelle non contano)
fsum() { find "$1" -type f -printf '%s\n' 2>/dev/null | awk '{t += $1} END {print t + 0}'; }
(
  ulimit -f 20480
  exec env LC_ALL=C.UTF-8 unzip -q -o -P '' -d "$s" "$w/a.zip" >/dev/null 2>&1
) &
pid=$!
(
  while sleep 0.05; do
    n="$(fsum "$s")"
    if [ "$n" -gt 209715200 ]; then
      : >"$w/b"
      kill -9 "$pid" 2>/dev/null
      exit 0
    fi
  done
) &
wp=$!
rc=0
wait "$pid" || rc=$?
pid=""
kill "$wp" 2>/dev/null
wp=""
[ ! -e "$w/b" ] || exit 75
# solo SIGXFSZ (153) è il tetto per file; altri segnali sono un errore generico
if [ "$rc" = 153 ]; then exit 74; fi
if [ "$rc" -ge 128 ]; then exit 1; fi
[ "$rc" = 0 ] || exit 72
chmod -R u+rwX -- "$s" 2>/dev/null
if [ -n "$(find "$s" -mindepth 1 ! -type f ! -type d | head -n 1)" ]; then exit 76; fi
# zipinfo mostra i caratteri di controllo come "?": i nomi veri si controllano qui
if [ -n "$(find "$s" -mindepth 1 -name '*[[:cntrl:]]*' | head -n 1)" ]; then exit 78; fi
find "$s" -mindepth 1 -print0 | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1 || exit 78
[ "$(find "$s" -mindepth 1 | wc -l)" -le 10000 ] || exit 73
if [ -n "$(find "$s" -type f -size +10485760c | head -n 1)" ]; then exit 74; fi
[ "$(fsum "$s")" -le 209715200 ] || exit 75
# permessi sani: gruppo del sito scrive, altri solo leggono, niente setuid/setgid sui file
find "$s" -type d -exec chmod u+rwx,g+rwx,o+rx,o-w,u-s {} +
find "$s" -type f -exec chmod u+rw,g+rw,o+r,o-w,a-s {} +
# cosa esiste già in destinazione: C = stesso nome, M = tipo diverso (file/cartella/collegamento)
export D="$PWD/$d" C="$w/c" M="$w/m"
: >"$C"
: >"$M"
(
  cd "$s" || exit 1
  find . -mindepth 1 -exec sh -c '
    for f; do
      r="${f#./}"
      t="$D/$r"
      if [ -d "$f" ] && [ ! -L "$f" ]; then
        if { [ -e "$t" ] || [ -L "$t" ]; } && { [ -L "$t" ] || [ ! -d "$t" ]; }; then printf "%s\0" "$r" >>"$M"; fi
      elif [ -d "$t" ]; then
        printf "%s\0" "$r" >>"$M"
      elif [ -e "$t" ] || [ -L "$t" ]; then
        printf "%s\0" "$r" >>"$C"
      fi
    done' sh {} +
) || exit 1
if [ "$ow" = 1 ]; then
  [ ! -s "$M" ] || exit 71
elif [ -s "$M" ] || [ -s "$C" ]; then
  cat "$M" "$C"
  exit 70
fi
if [ "$ow" = 1 ]; then
  cp -R -P --remove-destination --preserve=mode,timestamps -- "$s"/. "$d"/ || exit 1
else
  cp -R -P -n --preserve=mode,timestamps -- "$s"/. "$d"/ || exit 1
fi
EOS

# zip: DESTINAZIONE.zip PERCORSO... (relativi alla radice, tutti sotto public). Nell'archivio
# i nomi sono relativi a public/ ("public" stesso = tutto il contenuto). Uscite: 65 origine
# mancante, 67 cartella non valida, 68 oltre 200 MB, 70 la destinazione esiste.
read -r -d '' FM_SH_ZIP <<'EOS' || true
dest="$1"; shift
chkp "$dest" || exit 67
ex "$dest" && exit 70
for s; do
  chkp "$s" || exit 67
  ex "$s" || exit 65
done
sweep
tot=0
for s; do
  n="$(du -sbl -- "$s" 2>/dev/null | cut -f1)"
  tot=$((tot + ${n:-0}))
done
[ "$tot" -le 209715200 ] || exit 68
w=""
trap 'if [ -n "$w" ]; then rm -rf -- "$w"; fi' EXIT
trap 'exit 124' INT TERM
w="$(mktemp -d tmp/.vpsfiles-z.XXXXXX)" || exit 1
w="$PWD/$w"
final="$PWD/$dest"
for s; do
  case "$s" in
    public) set -- "$@" . ;;
    *) set -- "$@" "${s#public/}" ;;
  esac
  shift
done
cd public || exit 1
LC_ALL=C.UTF-8 zip -r -y -q -nw "$w/o.zip" -- "$@" >/dev/null 2>&1 || exit 1
mv -n -T -- "$w/o.zip" "$final" || exit 1
[ ! -e "$w/o.zip" ] || exit 70
EOS

# download-zip: PERCORSO. Zip su stdout, con il nome della cartella in testa; tetto 200 MB
# prima (sui file) e durante (sul flusso). Uscite: 65, 67, 68, 1.
read -r -d '' FM_SH_DLZIP <<'EOS' || true
p="$1"
chkp "$p" || exit 67
ex "$p" || exit 65
{ [ -d "$p" ] && [ ! -L "$p" ]; } || exit 66
sweep
n="$(du -sbl -- "$p" 2>/dev/null | cut -f1)"
[ "${n:-0}" -le 209715200 ] || exit 68
w=""
trap 'if [ -n "$w" ]; then rm -rf -- "$w"; fi' EXIT
trap 'exit 124' INT TERM
w="$(mktemp -d tmp/.vpsfiles-d.XXXXXX)" || exit 1
w="$PWD/$w"
case "$p" in
  */*) par="${p%/*}"; base="${p##*/}" ;;
  *) par="."; base="$p" ;;
esac
cd "$par" || exit 1
{ LC_ALL=C.UTF-8 zip -r -y -q -nw - -- "$base" 2>/dev/null; echo "$?" >"$w/rc"; } |
  { head -c 209715200; if [ "$(head -c 1 | wc -c)" != 0 ]; then : >"$w/big"; fi; }
[ ! -e "$w/big" ] || exit 68
[ "$(cat "$w/rc" 2>/dev/null)" = 0 ] || exit 1
EOS

# Comandi e numero di argomenti (vedi sopra) prima di qualsiasi altra cosa.
(($# >= 2)) || json_err "$USO"
cmd="$1"
dom="$2"
case "$cmd" in
  list | stat | read | mkdir | download-zip) (($# == 3)) || json_err "$USO" ;;
  zip) (($# >= 5)) || json_err "$USO" ;;
  unzip) (($# >= 4 && $# <= 5)) || json_err "$USO" ;;
  write) (($# >= 3 && $# <= 8)) || json_err "$USO" ;;
  rename) (($# == 4)) || json_err "$USO" ;;
  move | copy) (($# >= 5)) || json_err "$USO" ;;
  delete) (($# >= 4)) || json_err "$USO" ;;
  *) json_err "$USO" ;;
esac
info="$(fm_site_check "$dom" 2>&1)" || json_err "$info"
slug="${info%% *}"
root="${info#* }"

p=""
area=""
case "$cmd" in
  list | stat | read | mkdir | write | rename | download-zip)
    p="$3"
    area="$(fm_path_check "$p")" || json_err "percorso non valido o non consentito"
    ;;
esac

# Solo le voci dirette di logs/ si aprono come root; tutto il resto come utente del sito.
mode=site
if [[ "$area" == logs ]]; then mode=root; fi

# run_in COMANDO... — nella radice del sito, come root o come utente del sito.
run_in() {
  if [[ "$mode" == root ]]; then
    (
      cd "$root" || exit 1
      exec "$@"
    )
  else
    fm_as_site "$slug" "$root" "$@"
  fi
}

# site_sh SECONDI SCRIPT ARGOMENTI... — script sh come utente del sito, con timeout;
# FM_SH_LIB è anteposta. stdin passa.
site_sh() {
  local t="$1" script="$2"
  shift 2
  fm_as_site "$slug" "$root" timeout "$t" sh -c "$FM_SH_LIB"$'\n'"$script" sh "$@"
}

# fm_is_text PERCORSO — §3.3: al massimo 2 MB, nessun NUL nei primi 8 KB, UTF-8 valido.
# Legge al massimo 2 MB + 1 e sotto timeout: un fifo scambiato al volo non blocca.
fm_is_text() {
  local rc=0
  # shellcheck disable=SC2016
  run_in timeout 10 sh -c 'test -f "$1" -a ! -L "$1" || exit 1
a="$(head -c 8192 <"$1" | wc -c)"
b="$(head -c 8192 <"$1" | tr -d "\000" | wc -c)"
test "$a" = "$b" || exit 1
n="$(head -c 2097153 <"$1" | wc -c)"
test "$n" -le 2097152 || exit 1
head -c 2097153 <"$1" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1' sh "$1" >/dev/null 2>&1 || rc=$?
  return "$rc"
}

# fm_log COMANDO PERCORSO... — registro: comando, sito, al massimo 20 percorsi e il totale.
fm_log() {
  local c="$1" n=$(($# - 1)) list
  shift
  list="$(printf '%q ' "${@:1:20}")"
  log "files $c $dom $list""totale=$n"
}

# fm_conflict PERCORSO... — risposta di conflitto, uscita 1.
fm_conflict() {
  jq -nc '{ok: false, error: "esiste già", conflicts: $ARGS.positional}' --args "$@"
  exit 1
}

# fm_fail CODICE — messaggio per le uscite comuni degli script sh.
fm_fail() {
  case "$1" in
    65) json_err "origine non trovata" ;;
    66) json_err "non è un file regolare" ;;
    67) json_err "cartella non valida o percorso che passa da un collegamento" ;;
    68) json_err "troppo grande" ;;
    124) json_err "operazione scaduta" ;;
    *) json_err "operazione non riuscita" ;;
  esac
}

# under A B — A è B stesso o sta dentro B.
under() { [[ "$1" == "$2" || "$1" == "$2"/* ]]; }

# Parte comune di mkdir/write/rename: solo sotto public/, mai public stesso.
case "$cmd" in
  mkdir | write | rename)
    fm_writable "$p" || json_err "percorso in sola lettura o non consentito: $p"
    ;;
esac

case "$cmd" in
  list)
    isroot=false
    writable=false
    target="$p"
    if [[ "$area" == root ]]; then
      isroot=true
    elif [[ "$area" == public ]]; then
      writable=true
    elif [[ "$area" == logs && "$p" != logs ]]; then
      json_err "non è una cartella"
    elif [[ "$area" == wpconfig ]]; then
      json_err "non è una cartella"
    fi
    if [[ "$isroot" == true ]]; then
      # Voci virtuali: public e logs ci sono sempre, wp-config.php solo se esiste.
      { run_in find -P public logs wp-config.php -maxdepth 0 -printf "$FM_FIND_FMT" 2>/dev/null || true; } |
        jq -Rsc --arg path "$p" "$FM_JQ_DEF"'
          entries as $e
          | reduce ("public", "logs") as $n ($e;
              if any(.[]; .name == $n) then .
              else . + [{name: $n, type: "dir", size: 0, mtime: "0.000000000", perms: "drwxr-xr-x", raw: true}] end)
          | {ok: true, path: $path, writable: false, truncated: false, entries: sort_by(.name)}'
    else
      rc=0
      run_in test -d "$target" -a ! -L "$target" >/dev/null 2>&1 || rc=$?
      ((rc == 0)) || json_err "cartella non trovata: $p"
      rc=0
      run_in test -r "$target" -a -x "$target" >/dev/null 2>&1 || rc=$?
      ((rc == 0)) || json_err "cartella non leggibile: $p"
      # Al massimo FM_LIST_MAX + 1 voci (5 campi NUL ciascuna): oltre si taglia.
      { run_in find -P "$target" -mindepth 1 -maxdepth 1 -printf "$FM_FIND_FMT" 2>/dev/null |
        head -z -n $(((FM_LIST_MAX + 1) * 5)) || true; } |
        jq -Rsc --arg path "$p" --argjson w "$writable" --argjson max "$FM_LIST_MAX" "$FM_JQ_DEF"'
          entries as $e
          | {ok: true, path: $path, writable: $w, truncated: ($e | length > $max),
             entries: ($e[:$max] | sort_by(.name))}'
    fi
    ;;
  stat)
    entry="$({ run_in find -P "${p:-.}" -maxdepth 0 -printf "$FM_FIND_FMT" 2>/dev/null || true; } |
      jq -Rsc "$FM_JQ_DEF"' entries | .[0] // empty')"
    [[ -n "$entry" ]] || json_err "percorso non trovato: $p"
    text=false
    etype="$(jq -r .type <<<"$entry")"
    esize="$(jq -r .size <<<"$entry")"
    if [[ "$etype" == file ]] && ((esize <= FM_TEXT_MAX)); then
      if fm_is_text "$p"; then text=true; fi
    fi
    jq -nc --argjson e "$entry" --argjson t "$text" \
      '{ok: true, type: $e.type, size: $e.size, mtime: $e.mtime, text: $t}'
    ;;
  read)
    [[ "$area" != root ]] || json_err "non è un file"
    rc=0
    # Solo file regolari, mai collegamenti: la destinazione non viene aperta.
    # shellcheck disable=SC2016
    run_in timeout 120 sh -c 'test -f "$1" -a ! -L "$1" || exit 66
exec cat <"$1"' sh "$p" || rc=$?
    if ((rc == 66)); then json_err "non è un file regolare: $p"; fi
    if ((rc == 124)); then json_err "lettura scaduta: $p"; fi
    ((rc == 0)) || json_err "lettura non riuscita: $p"
    ;;
  write)
    shift 3
    ow=0
    im=""
    is=""
    while (($#)); do
      case "$1" in
        --overwrite)
          ow=1
          shift
          ;;
        --if-mtime)
          (($# >= 2)) || json_err "$USO"
          im="$2"
          shift 2
          ;;
        --if-size)
          (($# >= 2)) || json_err "$USO"
          is="$2"
          shift 2
          ;;
        *) json_err "$USO" ;;
      esac
    done
    if [[ -n "$im$is" ]]; then
      [[ "$im" =~ ^[0-9]+\.[0-9]{9}$ && "$is" =~ ^[0-9]+$ ]] || json_err "--if-mtime e --if-size vanno usati insieme, con valori validi"
      ow=1 # sostituire una versione precisa del file
    fi
    fm_log write "$p"
    rc=0
    out="$(site_sh 120 "$FM_SH_WRITE" "$p" "$ow" "$im" "$is")" || rc=$?
    case "$rc" in
      0) ;;
      70) fm_conflict "$p" ;;
      69)
        printf '{"ok":false,"error":"il file è cambiato","changed":true}\n'
        exit 1
        ;;
      68) json_err "file troppo grande (massimo 10 MB)" ;;
      *) fm_fail "$rc" ;;
    esac
    read -r wm ws <<<"$out"
    jq -nc --arg m "$wm" --argjson s "${ws:-0}" '{ok: true, mtime: $m, size: $s}'
    ;;
  mkdir)
    fm_log mkdir "$p"
    rc=0
    site_sh 30 "$FM_SH_MKDIR" "$p" || rc=$?
    case "$rc" in
      0) ;;
      70) fm_conflict "$p" ;;
      *) fm_fail "$rc" ;;
    esac
    json_ok
    ;;
  rename)
    new="$4"
    [[ -n "$new" && "$new" != */* ]] || json_err "nuovo nome non valido"
    np="${p%/*}/$new"
    fm_writable "$np" || json_err "nuovo nome non valido o non consentito"
    fm_log rename "$p" "$np"
    rc=0
    site_sh 30 "$FM_SH_RENAME" "$p" "$np" || rc=$?
    case "$rc" in
      0) ;;
      70) fm_conflict "$np" ;;
      *) fm_fail "$rc" ;;
    esac
    json_ok
    ;;
  move | copy)
    dest="$3"
    shift 3
    ow=0
    while (($#)) && [[ "$1" != -- ]]; do
      if [[ "$1" == --overwrite ]]; then ow=1; else json_err "$USO"; fi
      shift
    done
    [[ "${1-}" == -- ]] || json_err "$USO"
    shift
    (($# >= 1 && $# <= FM_MAX_PATHS)) || json_err "$USO"
    darea="$(fm_path_check "$dest")" || json_err "destinazione non valida"
    [[ "$darea" == public ]] || json_err "la destinazione deve stare in public"
    srcs=("$@")
    targets=()
    for s in "${srcs[@]}"; do
      fm_writable "$s" || json_err "percorso in sola lettura o non consentito: $s"
      t="$dest/${s##*/}"
      fm_path_check "$t" >/dev/null || json_err "nome di destinazione non valido: $t"
      targets+=("$t")
    done
    n=${#srcs[@]}
    for ((i = 0; i < n; i++)); do
      s="${srcs[i]}"
      t="${targets[i]}"
      [[ "$s" != "$t" ]] || json_err "origine e destinazione coincidono: $s"
      if under "$dest" "$s"; then json_err "la destinazione sta dentro l'origine: $s"; fi
      for ((j = 0; j < n; j++)); do
        if ((j != i)); then
          if under "$s" "${srcs[j]}"; then json_err "elementi duplicati o uno dentro l'altro"; fi
          [[ "${targets[j]}" != "$t" ]] || json_err "due elementi con lo stesso nome"
          if ((ow)) && under "${srcs[j]}" "$t"; then json_err "un'origine sta dentro una destinazione da sovrascrivere"; fi
        fi
      done
    done
    fm_log "$cmd verso $(printf "%q" "$dest")" "${srcs[@]}"
    rc=0
    site_sh 60 "$FM_SH_CHK" "$dest" "${srcs[@]}" || rc=$?
    ((rc == 0)) || fm_fail "$rc"
    if ((ow == 0)); then
      conf=()
      # base64: la variabile non può contenere NUL, e così si vede anche l'uscita dello script
      rc=0
      exb="$(site_sh 60 "$FM_SH_EXIST" "${targets[@]}" | base64 -w0)" || rc=$?
      ((rc == 0)) || fm_fail "$rc"
      mapfile -d '' conf < <(base64 -d <<<"$exb")
      ((${#conf[@]} == 0)) || fm_conflict "${conf[@]}"
    fi
    if [[ "$cmd" == copy ]]; then
      rc=0
      site_sh 120 "$FM_SH_SIZE" "${srcs[@]}" || rc=$?
      if ((rc == 68)); then json_err "la copia supera i 200 MB"; fi
      ((rc == 0)) || fm_fail "$rc"
    fi
    pairs=()
    for ((i = 0; i < n; i++)); do pairs+=("${srcs[i]}" "${targets[i]}"); done
    rc=0
    site_sh 120 "$FM_SH_MVCP" "$cmd" "$ow" "${pairs[@]}" || rc=$?
    ((rc == 0)) || fm_fail "$rc"
    json_ok
    ;;
  delete)
    [[ "$3" == -- ]] || json_err "$USO"
    shift 3
    (($# >= 1 && $# <= FM_MAX_PATHS)) || json_err "$USO"
    for s in "$@"; do
      fm_writable "$s" || json_err "percorso in sola lettura o non consentito: $s"
    done
    fm_log delete "$@"
    rc=0
    site_sh 120 "$FM_SH_DEL" "$@" || rc=$?
    ((rc == 0)) || fm_fail "$rc"
    json_ok
    ;;
  zip)
    dest="$3"
    [[ "$4" == -- ]] || json_err "$USO"
    shift 4
    (($# >= 1 && $# <= FM_MAX_PATHS)) || json_err "$USO"
    fm_writable "$dest" || json_err "destinazione non valida o non consentita: $dest"
    [[ "$dest" == *.zip && "${dest##*/}" != .zip ]] || json_err "la destinazione deve finire con .zip"
    for s in "$@"; do
      [[ "$(fm_path_check "$s")" == public ]] || json_err "percorso non consentito: $s"
    done
    fm_log zip "$dest" "$@"
    rc=0
    site_sh 120 "$FM_SH_ZIP" "$dest" "$@" || rc=$?
    case "$rc" in
      0) ;;
      70) fm_conflict "$dest" ;;
      68) json_err "la selezione supera i 200 MB" ;;
      *) fm_fail "$rc" ;;
    esac
    json_ok
    ;;
  unzip)
    arch="$3"
    dest="$4"
    ow=0
    if (($# == 5)); then
      [[ "$5" == --overwrite ]] || json_err "$USO"
      ow=1
    fi
    fm_writable "$arch" || json_err "archivio non valido o non consentito: $arch"
    [[ "$(fm_path_check "$dest")" == public ]] || json_err "la destinazione deve stare in public"
    fm_log unzip "$arch" "$dest"
    # unz_fail CODICE — messaggio per le uscite di elenco ed estrazione.
    unz_fail() {
      case "$1" in
        65) json_err "archivio non trovato: $arch" ;;
        66) json_err "l'archivio non è un file regolare: $arch" ;;
        71) json_err "un file ha lo stesso nome di una cartella (o di un collegamento): impossibile sovrascrivere" ;;
        72) json_err "archivio non valido" ;;
        73) json_err "l'archivio ha più di 10.000 voci" ;;
        74) json_err "l'archivio contiene un file oltre 10 MB" ;;
        75) json_err "l'archivio supera i 200 MB estratti" ;;
        76) json_err "l'archivio contiene collegamenti o file speciali" ;;
        77) json_err "l'archivio contiene percorsi non ammessi (assoluti o con ..)" ;;
        78) json_err "nomi non validi (non UTF-8 o con caratteri di controllo)" ;;
        79) json_err "l'archivio contiene voci cifrate (con password): non supportate" ;;
        *) fm_fail "$1" ;;
      esac
    }
    # fase 1: elenco e controlli sull'archivio; base64 per vedere l'uscita dello script
    # un solo budget di 120 s per le due fasi: alla seconda resta quanto avanzato
    t0=$SECONDS
    rc=0
    nb="$(site_sh 60 "$FM_SH_ZLIST" "$arch" | base64 -w0)" || rc=$?
    ((rc == 0)) || unz_fail "$rc"
    while IFS= read -r nm; do
      # il nome, unito alla destinazione, deve passare le regole di tutti i percorsi
      if ! fm_path_check "$dest/${nm%/}" >/dev/null; then
        if ! printf '%s' "$nm" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1; then json_err "nomi non validi (non UTF-8)"; fi
        json_err "nome non ammesso nell'archivio: $nm"
      fi
    done < <(base64 -d <<<"$nb")
    # fase 2: estrazione protetta
    left=$((120 - (SECONDS - t0)))
    ((left >= 5)) || json_err "operazione scaduta"
    rc=0
    ob="$(site_sh "$left" "$FM_SH_UNZIP" "$arch" "$dest" "$ow" | base64 -w0)" || rc=$?
    if ((rc == 70)); then
      conf=()
      mapfile -d '' conf < <(base64 -d <<<"$ob")
      conf=("${conf[@]/#/$dest/}")
      fm_conflict "${conf[@]}"
    fi
    ((rc == 0)) || unz_fail "$rc"
    json_ok
    ;;
  download-zip)
    [[ "$area" == public ]] || json_err "percorso non consentito: $p"
    rc=0
    site_sh 120 "$FM_SH_DLZIP" "$p" || rc=$?
    case "$rc" in
      0) ;;
      66) json_err "non è una cartella: $p" ;;
      68) json_err "il download supera i 200 MB" ;;
      *) fm_fail "$rc" ;;
    esac
    ;;
esac
