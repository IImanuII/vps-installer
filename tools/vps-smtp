#!/usr/bin/env bash
# vps-smtp show|set|test EMAIL|disable — configurazione email (JSON da stdin per set).
# JSON: {"host","port","user","pass","from","alert_email"}; pass vuota = tieni quella salvata.
# show non restituisce mai la password.
# I comandi che scrivono in /etc: PHP-FPM gira con ProtectSystem=full, dove /etc è
# in sola lettura, e sudo lanciato dal pannello ne eredita lo spazio dei mount. Ci si
# rilancia allora in un'unità systemd nuova (come vps-site): stdin, stdout e codice
# d'uscita passano intatti. Il percorso è assoluto e fisso, mai preso dall'ambiente.
case "${1:-}" in
  set | disable)
    if [[ -n "${SUDO_USER:-}" && -z "${VPS_SMTP_VIA_SYSTEMD:-}" ]]; then
      exec systemd-run --wait --pipe --collect --quiet --service-type=exec \
        --setenv=VPS_SMTP_VIA_SYSTEMD=1 /opt/vps/bin/vps-smtp "$@"
    fi
    ;;
esac
# Sotto sudo (o nell'unità del rilancio) l'ambiente del chiamante non deve influenzare
# lo script.
if [[ -n "${SUDO_USER:-}" || -n "${VPS_SMTP_VIA_SYSTEMD:-}" ]]; then
  VPS_OPT=/opt/vps
  VPS_LIB=$VPS_OPT/lib
  VPS_TEMPLATES=$VPS_OPT/templates
  VPS_LOG=/var/log/vps-tools.log
  unset MSMTPRC_LINK HTPASSWD_PMA ALIASES_FILE PMA_DIR NGINX_SNIPPETS CF_API CF_IPS_URL PMA_BASE_URL
  [[ -e "$VPS_LOG" ]] || install -m 640 /dev/null "$VPS_LOG"
  chmod 640 "$VPS_LOG"
fi
: "${VPS_OPT:=/opt/vps}" "${VPS_LOG:=/var/log/vps-tools.log}"
: "${VPS_TEMPLATES:=$VPS_OPT/templates}"
for _lib in "${VPS_LIB:-$VPS_OPT/lib}"/*.sh; do
  # shellcheck source=/dev/null
  source "$_lib"
done
tool_init

case "${1:-}" in
  set)
    cfg="$(read_stdin_limited 4096)"
    jq -e 'type == "object"' >/dev/null 2>&1 <<<"$cfg" || json_err "configurazione JSON non valida"
    SMTP_HOST="$(jq -r '.host // ""' <<<"$cfg")"
    SMTP_PORT="$(jq -r '.port // "" | tostring' <<<"$cfg")"
    SMTP_USER="$(jq -r '.user // ""' <<<"$cfg")"
    SMTP_PASS="$(jq -r '.pass // ""' <<<"$cfg")"
    SMTP_FROM="$(jq -r '.from // ""' <<<"$cfg")"
    ALERT_EMAIL="$(jq -r '.alert_email // ""' <<<"$cfg")"
    valid_domain "$SMTP_HOST" || json_err "host SMTP non valido"
    valid_smtp_port "$SMTP_PORT" || json_err "porta SMTP non valida (25, 465, 587, 2525)"
    # L'utente sta senza virgolette in msmtprc: niente spazi ne' controlli.
    [[ -n "$SMTP_USER" && ${#SMTP_USER} -le 254 && "$SMTP_USER" != *[[:space:][:cntrl:]]* ]] || json_err "utente SMTP non valido"
    { valid_email "$SMTP_FROM" && ((${#SMTP_FROM} <= 254)); } || json_err "mittente non valido"
    { valid_email "$ALERT_EMAIL" && ((${#ALERT_EMAIL} <= 254)); } || json_err "email degli avvisi non valida"
    SMTP_PASS_ESC=""
    if [[ -z "$SMTP_PASS" ]]; then
      # Il pannello manda la password solo quando cambia.
      SMTP_PASS_ESC="$(mail_saved_pass_esc)"
      [[ -n "$SMTP_PASS_ESC" ]] || json_err "password SMTP obbligatoria"
    else
      { valid_line "$SMTP_PASS" && ((${#SMTP_PASS} <= 256)) && [[ "$SMTP_PASS" != *[[:cntrl:]]* ]]; } || json_err "password SMTP non valida"
    fi
    mail_render_config
    manifest_set '.mail.configured = true | .mail.alert_email = $e' --arg e "$ALERT_EMAIL"
    json_ok
    ;;
  show)
    if [[ -f "$VPS_OPT/secrets/msmtprc" ]]; then
      json_ok --arg h "$(mail_conf_get host)" --arg p "$(mail_conf_get port)" --arg u "$(mail_conf_get user)" \
        --arg f "$(mail_conf_get from)" --arg e "$(jq -r '.mail.alert_email // ""' "$VPS_OPT/manifest.json" 2>/dev/null || true)" \
        '{ok: true, configured: true, host: $h, port: ($p | tonumber? // null), user: $u, from: $f,
          alert_email: (if $e == "" then null else $e end)}'
    else
      json_ok -n '{ok: true, configured: false, host: null, port: null, user: null, from: null, alert_email: null}'
    fi
    ;;
  test)
    valid_email "${2:-}" || json_err "uso: vps-smtp test EMAIL"
    [[ -f "$VPS_OPT/secrets/msmtprc" ]] || json_err "email non configurata"
    mail_send_test "$2" || json_err "invio non riuscito: ${MAIL_ERR:-motivo sconosciuto}"
    json_ok
    ;;
  disable)
    rm -f "$VPS_OPT/secrets/msmtprc" "$MSMTPRC_LINK"
    printf '# vps-installer: nessun alias configurato\n' | write_file "$ALIASES_FILE" 644 root:root
    manifest_set '.mail.configured = false | .mail.alert_email = null'
    json_ok
    ;;
  *)
    json_err "uso: vps-smtp show|set|test EMAIL|disable"
    ;;
esac
