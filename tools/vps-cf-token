#!/usr/bin/env bash
# vps-cf-token set|test — sostituisce (token da stdin) o verifica il token Cloudflare.
# Sotto sudo l'ambiente del chiamante non deve influenzare lo script.
if [[ -n "${SUDO_USER:-}" ]]; then
  VPS_OPT=/opt/vps
  VPS_LIB=$VPS_OPT/lib
  VPS_TEMPLATES=$VPS_OPT/templates
  VPS_LOG=/var/log/vps-tools.log
  unset MSMTPRC_LINK HTPASSWD_PMA ALIASES_FILE PMA_DIR NGINX_SNIPPETS CF_API CF_IPS_URL PMA_BASE_URL SITES_DIR SSHTUNNEL_STATE
  [[ -e "$VPS_LOG" ]] || install -m 640 /dev/null "$VPS_LOG"
  chmod 640 "$VPS_LOG"
fi
export LC_ALL=C
: "${VPS_OPT:=/opt/vps}" "${VPS_LOG:=/var/log/vps-tools.log}"
: "${VPS_TEMPLATES:=$VPS_OPT/templates}"
for _lib in "${VPS_LIB:-$VPS_OPT/lib}"/*.sh; do
  # shellcheck source=/dev/null
  source "$_lib"
done
tool_init

zone="$(jq -r '.cloudflare.zone // empty' "$(manifest_path)")"

# cf_missing_zones — le zone che il token deve vedere (pannello + siti registrati;
# un sito senza zona, es. di una versione vecchia, si ignora) e che non vede.
# Stampa le mancanti in ordine, separate da ", "; 1 se Cloudflare non risponde.
cf_missing_zones() {
  local visibili richieste f
  visibili="$(cf_list_zones)" || return 1
  richieste="$({
    printf '%s\n' "$zone"
    for f in "$SITES_DIR"/*.json; do
      if [[ -f "$f" ]]; then jq -r '.zone.name // empty' "$f"; fi
    done
  } | sort -u)"
  comm -23 <(grep -v '^$' <<<"$richieste" || true) <(sort -u <<<"$visibili") | paste -sd, - | sed 's/,/, /g'
}

case "${1:-}" in
  set)
    token="$(trim "$(read_stdin_limited 512)")"
    valid_cf_token "$token" || json_err "formato del token non valido"
    [[ -n "$zone" ]] || json_err "Cloudflare non è attivo su questa VPS"
    CF_API_TOKEN="$token" cf_find_zone "$zone" >/dev/null || json_err "il token non ha accesso alla zona $zone"
    mancanti="$(CF_API_TOKEN="$token" cf_missing_zones)" || json_err "il token non è valido o Cloudflare non risponde"
    [[ -z "$mancanti" ]] || json_err "il token non vede le zone: $mancanti"
    # Con l'accesso SSH attivo il nuovo token deve gestirne tunnel e app: se non li
    # vede, il pannello non potrebbe più cambiarlo né disattivarlo. Un 404 (risorsa
    # cancellata a mano) non è un permesso mancante: la disattivazione lo gestisce.
    if [[ -f "$SSHTUNNEL_STATE" ]]; then
      acc="$(jq -r '.account_id // empty' "$SSHTUNNEL_STATE")"
      tid="$(jq -r '.tunnel_id // empty' "$SSHTUNNEL_STATE")"
      aid="$(jq -r '.app_id // empty' "$SSHTUNNEL_STATE")"
      for p in "/accounts/$acc/cfd_tunnel/$tid" "/accounts/$acc/access/apps/$aid"; do
        if ! CF_API_TOKEN="$token" _st_req GET "$p" && ! _st_gone; then
          json_err "l'accesso SSH è attivo: il nuovo token deve poterlo gestire, oppure disattivalo prima"
        fi
      done
    fi
    cf_write_ini "$token"
    log "vps-cf-token: token di sistema sostituito"
    json_ok
    ;;
  test)
    [[ -n "$zone" ]] || json_err "Cloudflare non è attivo su questa VPS"
    # shellcheck disable=SC2034
    CF_API_TOKEN="$(cf_token_from_ini)"
    cf_find_zone "$zone" >/dev/null || json_err "il token salvato non ha accesso alla zona $zone"
    mancanti="$(cf_missing_zones)" || json_err "il token non è valido o Cloudflare non risponde"
    [[ -z "$mancanti" ]] || json_err "il token non vede le zone: $mancanti"
    n="$(cf_list_zones | grep -c . || true)"
    json_ok --argjson n "$n" '{ok: true, zones: $n}'
    ;;
  *)
    json_err "uso: vps-cf-token set|test (token da stdin per set)"
    ;;
esac
