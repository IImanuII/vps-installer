#!/usr/bin/env bash
# vps-cf-purge ZONA [--all|--host] — svuota la cache Cloudflare di ZONA con il token
# di sistema. Senza opzioni gli indirizzi arrivano da stdin, uno per riga (1-30): negli
# argomenti si vedrebbero in `ps`. Con --host da stdin arrivano i nomi (1-30) e si
# svuota tutto ciò che è servito con quei nomi, senza toccare gli altri siti della zona.
# Contratto in docs/PANEL-HANDOFF.md, sezione 4.
# Sotto sudo l'ambiente del chiamante non deve influenzare lo script.
if [[ -n "${SUDO_USER:-}" ]]; then
  VPS_OPT=/opt/vps
  VPS_LIB=$VPS_OPT/lib
  VPS_TEMPLATES=$VPS_OPT/templates
  VPS_LOG=/var/log/vps-tools.log
  unset CF_API
  [[ -e "$VPS_LOG" ]] || install -m 640 /dev/null "$VPS_LOG"
  chmod 640 "$VPS_LOG"
fi
: "${VPS_OPT:=/opt/vps}" "${VPS_LOG:=/var/log/vps-tools.log}"
: "${VPS_TEMPLATES:=$VPS_OPT/templates}"
export LC_ALL=C
for _lib in "${VPS_LIB:-$VPS_OPT/lib}"/*.sh; do
  # shellcheck source=/dev/null
  source "$_lib"
done
tool_init

USO="uso: vps-cf-purge ZONA [--all|--host] (indirizzi da stdin senza opzioni, host con --host)"
(($# >= 1 && $# <= 2)) || json_err "$USO"
zone="$1"
mode=urls
case "${2:-}" in
  --all) mode=all ;;
  --host) mode=hosts ;;
  "") ;;
  *) json_err "$USO" ;;
esac
valid_domain "$zone" || json_err "zona non valida"
[[ -f "$VPS_OPT/secrets/cloudflare.ini" ]] || json_err "Cloudflare non è attivo su questa VPS"
# shellcheck disable=SC2034
CF_API_TOKEN="$(cf_token_from_ini)"

if [[ "$mode" == all ]]; then
  body='{"purge_everything":true}'
  n=all
elif [[ "$mode" == hosts ]]; then
  # Purge per host: Cloudflare lo accetta su tutti i piani. Se lo rifiuta si dà
  # errore e basta: ricadere su purge_everything svuoterebbe anche gli altri siti.
  hosts=()
  # Si leggono 10001 byte: 30 nomi da 253 caratteri ci stanno, di più è troppo.
  dati="$(read_stdin_limited 10001)"
  ((${#dati} <= 10000)) || json_err "troppi host: il limite è 30"
  while IFS= read -r riga || [[ -n "$riga" ]]; do
    riga="$(trim "$riga")"
    if [[ -n "$riga" ]]; then hosts+=("${riga,,}"); fi
  done <<<"$dati"
  ((${#hosts[@]} >= 1)) || json_err "nessun host"
  ((${#hosts[@]} <= 30)) || json_err "troppi host: il limite è 30"
  for h in "${hosts[@]}"; do
    valid_purge_host "$h" "$zone" || json_err "host non valido: $h"
  done
  body="$(jq -nc '{hosts: $ARGS.positional}' --args "${hosts[@]}")"
  n="${#hosts[@]}"
else
  urls=()
  # Si leggono 40001 byte: se arrivano più di 40000 l'elenco è troppo lungo.
  dati="$(read_stdin_limited 40001)"
  ((${#dati} <= 40000)) || json_err "troppi indirizzi: il limite è 30"
  while IFS= read -r riga || [[ -n "$riga" ]]; do
    riga="$(trim "$riga")"
    if [[ -n "$riga" ]]; then urls+=("$riga"); fi
  done <<<"$dati"
  ((${#urls[@]} >= 1)) || json_err "nessun indirizzo"
  ((${#urls[@]} <= 30)) || json_err "troppi indirizzi: il limite è 30"
  for u in "${urls[@]}"; do
    valid_purge_url "$u" "$zone" || json_err "indirizzo non valido: $u"
  done
  body="$(jq -nc '{files: $ARGS.positional}' --args "${urls[@]}")"
  n="${#urls[@]}"
fi

zrc=0
zid="$(cf_zone_id "$zone")" || zrc=$?
if ((zrc == 2)); then json_err "Cloudflare non risponde"; fi
if ((zrc != 0)); then json_err "zona non trovata: $zone"; fi
resp="$(cf_api POST "/zones/$zid/purge_cache" "$body")" || json_err "Cloudflare non risponde"
if ! jq -e '.success == true' >/dev/null 2>&1 <<<"$resp"; then
  msg="$(jq -r '[.errors[]?.message] | join("; ")' <<<"$resp" 2>/dev/null || true)"
  log "vps-cf-purge: $zone rifiutato da Cloudflare: ${msg:-risposta non valida}"
  json_err "Cloudflare ha rifiutato la richiesta: ${msg:-risposta non valida}"
fi
if [[ "$mode" == hosts ]]; then
  log "vps-cf-purge: $zone svuotata (host: ${hosts[*]})"
else
  log "vps-cf-purge: $zone svuotata ($n)"
fi
if [[ "$n" == all ]]; then
  json_ok '{ok: true, purged: "all"}'
else
  json_ok --argjson n "$n" '{ok: true, purged: $n}'
fi
